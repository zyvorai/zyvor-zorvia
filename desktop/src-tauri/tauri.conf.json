{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zorvia",
  "version": "0.1.0",
  "identifier": "dev.zyvor.zorvia.desktop",
  "build": { "frontendDist": "../public" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zorvia",
        "width": 1360,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": { "stage/bin/zorvia": "bin/zorvia", "stage/web": "web" },
    "copyright": "Copyright © 2026 ZyvorAI Labs Private Limited",
    "category": "DeveloperTool",
    "shortDescription": "Native macOS console for Zorvia / KubeVirt",
    "macOS": { "minimumSystemVersion": "12.0", "hardenedRuntime": true }
  }
}
